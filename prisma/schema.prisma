generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String         @id @default(uuid())
  name                      String         @default("")
  email                     String         @unique
  password                  String
  isVerified                Boolean        @default(false)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  plan                      String         @default("free")
  apiKey                    String?        @unique
  accessCode                String         @unique
  deviceLimit               Int            @default(1)
  createdAt                 DateTime       @default(now())
  emailAddress              String?
  emailAppPasswordEncrypted String?
  emailAppPasswordHash      String?
  categories                Category[]
  emails                    Email[]
  emailAccounts             EmailAccount[]
  prompts                   Prompt[]
}

model PendingRegistration {
  id                        String   @id @default(uuid())
  name                      String
  email                     String   @unique
  passwordHash              String
  verificationCode          String
  verificationCodeExpiresAt DateTime
  createdAt                 DateTime @default(now())
}

model EmailAccount {
  id       String  @id @default(uuid())
  provider String
  email    String
  userId   String
  emails   Email[]
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Email {
  id          String        @id @default(uuid())
  subject     String
  body        String
  aiReply     String?
  manualReply String?
  category    String        @default("general")
  status      String        @default("draft")
  tag         String        @default("unread")
  readyToSend Boolean       @default(false)
  readyToSell Boolean       @default(false)
  createdAt   DateTime      @default(now())
  userId      String
  accountId   String?
  senderEmail String?
  account     EmailAccount? @relation(fields: [accountId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Prompt {
  id      String @id @default(uuid())
  title   String
  content String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id     String @id @default(uuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmailStatus {
  draft
  ready_send
  sent
  analyzed
}

enum EmailTag {
  unread
  read
  sent
  important
}
